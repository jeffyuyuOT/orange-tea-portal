# Copy this file to .env.local for local development (Vite auto-loads .env.local
# and it is git-ignored). For deployed builds (Cloudflare Pages), set these as
# Environment Variables in the Pages project settings — you can set different
# values per Pages "Production" vs "Preview" branch environment, which is how
# you keep a test build and a production build from the same repo/branch setup
# you already use for the inventory app (test branch vs main branch).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
